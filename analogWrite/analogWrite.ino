void setup() {
  // put your setup code here, to run once:
  pinMode(2,OUTPUT);
}

void loop() {
  // put your main code here, to run repeatedly:
  analogWrite(2,0);
  delay(2000);
    analogWrite(2,25);
  delay(2000);
    analogWrite(2,50);
  delay(2000);
    analogWrite(2,75);
  delay(2000);
    analogWrite(2,100);
  delay(2000);
    analogWrite(2,125);
  delay(2000);
    analogWrite(2,150);
  delay(2000);
    analogWrite(2,175);
  delay(2000);
    analogWrite(2,200);
  delay(2000);
    analogWrite(2,225);
  delay(2000);
    analogWrite(2,255);
  delay(2000);
}
